# Telegram Bot API credentials used by app/api/lead/route.ts to notify
# about new JoinForm submissions.
#
# 1. Talk to @BotFather in Telegram -> /newbot -> follow the prompts.
#    BotFather gives you the token, e.g. 123456789:AA...xyz
# 2. Send any message to your new bot (or add it to a group/channel),
#    then open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser
#    and read the "chat":{"id": ...} value from the JSON response.
#    For a group chat the id is negative (e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
